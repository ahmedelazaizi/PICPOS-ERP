+-- ============================================================
+-- PICPOS / URAL ERP — Migration v151: Shift Closing Snapshot
+-- تطبيق على قاعدة بيانات PostgreSQL موجودة (بدون حذف وإعادة بناء)
+-- ============================================================
+-- التشغيل: psql -U <user> -d <database> -f migration_v151_shift_closing_snapshot.sql
+-- ============================================================
+
+BEGIN;
+
+-- ──────────────────────────────────────────────────────────────
+-- لقطة أرقام إغلاق الوردية وقت الإقفال (JSON)
+--
+-- السبب: إعادة طباعة وردية مقفولة مكانتش ممكنة. إعادة الحساب لوحدها
+-- مش كافية لأن المبالغ **الفعلية** دي إدخال الكاشير، ومكانش ليها أعمدة
+-- غير `actual_cash` — الفعلي للبطاقة وكليك كان مدفون جوه نص `notes`.
+-- فأي «إعادة طباعة» متبنية من غيرهم مش هتطابق الورقة اللي الكاشير مضاها.
+--
+-- NULL للورديات المقفولة قبل الترقية — دي بيتعاد حسابها وبتتوسم في الواجهة.
+-- ──────────────────────────────────────────────────────────────
+ALTER TABLE shifts
+    ADD COLUMN IF NOT EXISTS closing_snapshot TEXT;
+
+COMMIT;
+
+-- ============================================================
+-- ملاحظات:
+-- 1. العمود nullable بلا default — أرخص تغيير سكيما على قواعد بيانات كبيرة
+-- 2. مفيش backfill: الورديات القديمة مالهاش لقطة تُسترجع أصلاً
+-- 3. المحتوى JSON لكل الوسائط اللي `printShiftClosingReport` بتستقبلها
+-- ============================================================
