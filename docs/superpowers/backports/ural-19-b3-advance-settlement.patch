+  Future<void> markPresentFullFebruary() async {
+    for (var d = 1; d <= 28; d++) {
+      await db.into(db.employeeAttendance).insert(
+            EmployeeAttendanceCompanion.insert(
+              employeeId: employeeId,
+              date: DateTime(2026, 2, d),
