@@ -0,0 +1,342 @@
+// ═══════════════════════════════════════════════════════════════════════════
+// §٥/٢ — فلترُ منشئ التقارير: صيغةٌ مهيكلة بمعاملاتٍ مربوطة.
+// ═══════════════════════════════════════════════════════════════════════════
+//
+// السكيما **توثّق العقد** منذ البداية:
+//     /// Filter conditions as JSON: [{"field":"price","op":">","value":100}]
+//     TextColumn get filters => text().nullable()();
+// والتنفيذُ كان يعامل العمودَ **نصَّ SQL خاماً** ويُلحقه بالـ`WHERE` كما هو.
+//
+// فالعطلُ ليس أمنياً بالدرجة الأولى — لا مسارَ في التطبيق يُنشئ فلتراً أصلاً
+// (الواجهةُ لا تمرّره و`custom_reports` غيرُ مُزامَن) — بل **تخالفُ التنفيذِ
+// لعقده المكتوب**: من يبني واجهةَ الفلتر يتبع تعليقَ السكيما، فيكتب JSON
+// مهيكلاً، فيُبثّ كـSQL ⇒ استعلامٌ مكسور أو تقريرٌ مرفوض.
+//
+// ── والأمانُ من البناء لا من الفحص ─────────────────────────────────────────
+// اسمُ العمود يُختار من `getAvailableFields(sourceEntity)` — **قائمةٌ مغلقة** —
+// والقيمةُ تُربَط معاملاً. فلا يوجد نصٌّ من المستخدم يصل إلى الـSQL، والحقنُ
+// يصير مستحيلاً بالبناء لا مرفوضاً بفحصٍ يُنسى تحديثه.
+//
+// ── والمسارُ الخام يبقى مقبولاً ─────────────────────────────────────────────
+// UralCash **مطروح**، وحذفُ المسار كسرٌ لمنتجٍ مطروح مقابل فائدةٍ صفر. فالخامُّ
+// يبقى محصَّناً للنصوص القديمة، والمهيكلُ هو ما تنتجه الواجهةُ الجديدة. والتمييزُ
+// بأول حرفٍ غيرِ فراغ: `[` ⇒ مهيكل.
+// ═══════════════════════════════════════════════════════════════════════════
+
+import 'dart:convert';
+
+import 'package:drift/drift.dart' hide isNotNull, isNull;
+import 'package:flutter_test/flutter_test.dart';
+import 'package:ural_erp/data/database/database.dart';
+
+void main() {
+  late AppDatabase db;
+  late int branchA;
+  late int whA;
+  var seq = 0;
+
+  Future<int> report(String entity, String columns, {Object? filters}) =>
+      db.into(db.customReports).insert(CustomReportsCompanion.insert(
+            name: 'ت',
+            sourceEntity: entity,
+            columns: columns,
+            filters: Value(filters is String ? filters : jsonEncode(filters)),
+          ));
+
+  Future<int> product(String name, double price,
+          {String? barcode, bool isActive = true}) =>
+      db.into(db.products).insert(ProductsCompanion.insert(
+            code: 'P${++seq}',
+            name: name,
+            barcode: Value(barcode),
+            salePrice: Value(price),
+            costPrice: Value(price / 2),
+            isActive: Value(isActive),
+          ));
+
+  Future<int> invoice(String number, DateTime date, {double total = 100}) =>
+      db.into(db.salesInvoices).insert(SalesInvoicesCompanion.insert(
+            invoiceNumber: number,
+            warehouseId: whA,
+            userId: 1,
+            invoiceDate: date,
+            branchId: Value(branchA),
+            total: Value(total),
+          ));
+
+  setUp(() async {
+    seq = 0;
+    db = AppDatabase.forTesting();
+    branchA = await db.into(db.branches).insert(BranchesCompanion.insert(
+        name: 'فرع أ', globalId: const Value('gid-sf-a')));
+    whA = await db.into(db.warehouses).insert(
+        WarehousesCompanion.insert(name: 'مخزن أ', branchId: Value(branchA)));
+    await product('قلم', 10);
+    await product('دفتر', 100);
+    await product('حاسوب', 5000);
+  });
+
+  tearDown(() => db.close());
+
+  Future<List<String>> names(int reportId, {Set<int>? scope}) async {
+    final rows = await db.executeReport(reportId, allowedBranchIds: scope);
+    return rows.map((r) => r['name'] as String).toList();
+  }
+
+  group('عوامل المقارنة على الأرقام', () {
+    test('أكبر من', () async {
+      final id = await report('products', 'name',
+          filters: [
+            {'field': 'price', 'op': '>', 'value': 50}
+          ]);
+      expect(await names(id), containsAll(<String>['دفتر', 'حاسوب']));
+      expect(await names(id), isNot(contains('قلم')));
+    });
+
+    test('أصغر من أو يساوي', () async {
+      final id = await report('products', 'name',
+          filters: [
+            {'field': 'price', 'op': '<=', 'value': 100}
+          ]);
+      final n = await names(id);
+      expect(n, containsAll(<String>['قلم', 'دفتر']));
+      expect(n, isNot(contains('حاسوب')));
+    });
+
+    test('يساوي', () async {
+      final id = await report('products', 'name',
+          filters: [
+            {'field': 'price', 'op': '=', 'value': 100}
+          ]);
+      expect(await names(id), ['دفتر']);
+    });
+
+    test('لا يساوي', () async {
+      final id = await report('products', 'name',
+          filters: [
+            {'field': 'price', 'op': '!=', 'value': 100}
+          ]);
+      expect(await names(id), isNot(contains('دفتر')));
+    });
+
+    test('الفلترُ يترجم اسمَ الحقل بنفس خريطة الأعمدة', () async {
+      // `price` ليس اسمَ العمود — العمودُ `sale_price`. لو افترق الفلترُ عن
+      // خريطةِ `SELECT` لصار `no such column` أو فلترةً على عمودٍ آخر.
+      final id = await report('products', 'name, price',
+          filters: [
+            {'field': 'price', 'op': '>', 'value': 4000}
+          ]);
+      final rows = await db.executeReport(id);
+      expect(rows.map((r) => r['name']), ['حاسوب']);
+      expect(rows.first['price'], 5000);
+    });
+  });
+
+  group('عوامل النصّ', () {
+    test('يحتوي', () async {
+      final id = await report('products', 'name',
+          filters: [
+            {'field': 'name', 'op': 'contains', 'value': 'حاس'}
+          ]);
+      expect(await names(id), ['حاسوب']);
+    });
+
+    test('يحتوي — % في القيمة نصٌّ لا محرفُ بدل', () async {
+      await product('خصم %50', 7);
+      // ‏«دفتر ٥٠ ورقة» هو ما يوقع الطفرة: بلا هروبِ `%` يصير النمطُ `%%50%`
+      // فيلتقطه، ومعه يصير النمطُ `%\%50%` فلا يلتقطه إلا حرفياً.
+      await product('دفتر 50 ورقة', 8);
+      final id = await report('products', 'name',
+          filters: [
+            {'field': 'name', 'op': 'contains', 'value': '%50'}
+          ]);
+      expect(await names(id), ['خصم %50'],
+          reason: 'القيمةُ مربوطةٌ معاملاً ومهروبةٌ، فـ% داخلها نصٌّ');
+    });
+
+    test('يحتوي — _ في القيمة نصٌّ لا محرفَ واحدٍ أيّاً كان', () async {
+      await product('A_B', 3);
+      await product('AXB', 4);
+      final id = await report('products', 'name',
+          filters: [
+            {'field': 'name', 'op': 'contains', 'value': 'A_B'}
+          ]);
+      expect(await names(id), ['A_B'],
+          reason: '`_` محرفُ بدلٍ في LIKE تماماً كـ%');
+    });
+
+    test('لا يساوي يشمل الصفوفَ الخالية', () async {
+      await product('بلا باركود', 3);
+      await product('له باركود', 4, barcode: 'BC-1');
+      final id = await report('products', 'name',
+          filters: [
+            {'field': 'barcode', 'op': '!=', 'value': 'BC-1'}
+          ]);
+      expect(await names(id), contains('بلا باركود'),
+          reason: 'صنفٌ بلا باركود «ليس BC-1» فعلاً — و`!= ?` وحدَه '
+              'يُسقطه لأن مقارنةَ NULL تُنتج NULL');
+      expect(await names(id), isNot(contains('له باركود')));
+    });
+  });
+
+  group('المنطقيّ', () {
+    test('يساوي false يرجّع غيرَ النشط وحده', () async {
+      await product('موقوف', 9, isActive: false);
+      final id = await report('products', 'name',
+          filters: [
+            {'field': 'is_active', 'op': '=', 'value': false}
+          ]);
+      expect(await names(id), ['موقوف']);
+    });
+  });
+
+  group('التواريخ — دلالةُ اليوم لا اللحظة', () {
+    setUp(() async {
+      await invoice('INV-08', DateTime(2026, 8, 10, 14, 30));
+      await invoice('INV-09', DateTime(2026, 8, 11, 9, 0));
+      await invoice('INV-10', DateTime(2026, 8, 12, 23, 59));
+    });
+
+    Future<List<String>> numbers(int id) async {
+      final rows = await db.executeReport(id);
+      return rows.map((r) => r['invoice_number'] as String).toList();
+    }
+
+    test('يساوي يوماً يشمل اليومَ كلَّه لا لحظةَ منتصف الليل', () async {
+      final id = await report('sales_invoices', 'invoice_number',
+          filters: [
+            {'field': 'date', 'op': '=', 'value': '2026-08-10'}
+          ]);
+      expect(await numbers(id), ['INV-08'],
+          reason: 'الفاتورةُ في ١٤:٣٠ — مطابقةُ اللحظةِ تُرجع صفراً صامتاً');
+    });
+
+    test('أصغر من أو يساوي يشمل آخرَ اليوم', () async {
+      final id = await report('sales_invoices', 'invoice_number',
+          filters: [
+            {'field': 'date', 'op': '<=', 'value': '2026-08-11'}
+          ]);
+      expect(await numbers(id), ['INV-08', 'INV-09'],
+          reason: 'فاتورةُ ٠٩:٠٠ من يوم ١١ داخلةٌ في «حتى ١١»');
+    });
+
+    test('أكبر من يومٍ يبدأ من اليوم التالي', () async {
+      final id = await report('sales_invoices', 'invoice_number',
+          filters: [
+            {'field': 'date', 'op': '>', 'value': '2026-08-11'}
+          ]);
+      expect(await numbers(id), ['INV-10']);
+    });
+  });
+
+  group('شروطٌ متعدّدة تُجمَع بـAND', () {
+    test('نطاقٌ سعريّ', () async {
+      final id = await report('products', 'name',
+          filters: [
+            {'field': 'price', 'op': '>', 'value': 5},
+            {'field': 'price', 'op': '<', 'value': 1000},
+          ]);
+      final n = await names(id);
+      expect(n, containsAll(<String>['قلم', 'دفتر']));
+      expect(n, isNot(contains('حاسوب')));
+    });
+  });
+
+  group('الرفض — الأمان من البناء', () {
+    test('حقلٌ خارج القائمة المغلقة يُرفَض التقريرُ كلُّه', () async {
+      final id = await report('products', 'name',
+          filters: [
+            {'field': 'id) OR 1=1 --', 'op': '=', 'value': 1}
+          ]);
+      expect(await names(id), isEmpty,
+          reason: 'اسمُ العمود من `getAvailableFields` وحدها');
+    });
+
+    test('حقلٌ سليمُ الشكل لكن ليس من حقول الكيان يُرفَض', () async {
+      final id = await report('products', 'name',
+          filters: [
+            {'field': 'balance', 'op': '>', 'value': 0}
+          ]);
+      expect(await names(id), isEmpty,
+          reason: '`balance` حقلُ الأطراف لا الأصناف');
+    });
+
+    test('عاملٌ غيرُ مدعوم يُرفَض', () async {
+      final id = await report('products', 'name',
+          filters: [
+            {'field': 'price', 'op': 'GLOB', 'value': '*'}
+          ]);
+      expect(await names(id), isEmpty);
+    });
+
+    test('عاملٌ لا يليق بنوع الحقل يُرفَض', () async {
+      final id = await report('products', 'name',
+          filters: [
+            {'field': 'price', 'op': 'contains', 'value': '10'}
+          ]);
+      expect(await names(id), isEmpty,
+          reason: '«يحتوي» على رقمٍ يفلتر بالنصّ فيعطي نتائجَ غيرَ متوقَّعة');
+    });
+
+    test('قيمةٌ غيرُ رقميةٍ لحقلٍ رقميّ تُرفَض لا تُرجع صفراً صامتاً', () async {
+      final id = await report('products', 'name',
+          filters: [
+            {'field': 'price', 'op': '>', 'value': 'غالي'}
+          ]);
+      expect(await names(id), isEmpty);
+      // ⚠️ «فارغ» وحدَه **لا يميّز**: لو مُرِّر النصُّ معاملاً لكان
+      // `sale_price > 'غالي'` فارغاً أيضاً — فالنصُّ في SQLite أكبرُ من كلِّ
+      // رقم. فالدليلُ أن الاستعلامَ **لم يُنفَّذ أصلاً**: سجلُّ التشغيل
+      // (`saved_report_runs`) لا يُكتَب إلا بعد تنفيذٍ فعليّ.
+      expect(await db.select(db.savedReportRuns).get(), isEmpty,
+          reason: 'الرفضُ قبل التنفيذ لا بعده');
+    });
+
+    test('JSON مهيكلٌ فاسد يُرفَض لا يُبَثّ SQL', () async {
+      final id = await report('products', 'name', filters: '[{"field":');
+      expect(await names(id), isEmpty);
+    });
+
+    test('قائمةٌ فارغة لا تكسر الاستعلام', () async {
+      final id = await report('products', 'name', filters: <Object>[]);
+      expect(await names(id), hasLength(3),
+          reason: 'بلا شروطٍ ⇒ بلا تقييد، لا `WHERE ()` مكسور');
+    });
+
+    test('قيمةٌ نصّيةٌ فيها اقتباسٌ لا تكسر الاستعلام', () async {
+      await product("قلم O'Brien", 3);
+      final id = await report('products', 'name',
+          filters: [
+            {'field': 'name', 'op': '=', 'value': "قلم O'Brien"}
+          ]);
+      expect(await names(id), ["قلم O'Brien"],
+          reason: 'المعاملُ المربوطُ يمرّر الاقتباسَ نصّاً');
+    });
+  });
+
+  group('الحصرُ يبقى فوق الفلتر', () {
+    test('فلترٌ مهيكلٌ لا يوسّع نطاق الفروع', () async {
+      await invoice('INV-A', DateTime(2026, 8, 10));
+      final id = await report('sales_invoices', 'invoice_number',
+          filters: [
+            {'field': 'total', 'op': '>', 'value': 0}
+          ]);
+
+      final rows = await db.executeReport(id, allowedBranchIds: <int>{});
+      expect(rows, isEmpty, reason: 'الحصرُ الفاشلُ مقفولاً يغلب أي فلتر');
+    });
+  });
+
+  group('المسارُ الخام لم يُكسَر', () {
+    test('نصُّ SQL سليمٌ لا يزال يعمل', () async {
+      final id = await report('products', 'name',
+          filters: 'products.sale_price > 50');
+      expect(await names(id), containsAll(<String>['دفتر', 'حاسوب']));
+    });
+
+    test('نصٌّ خامٌّ يحاول الهروب لا يزال يُرفَض', () async {
+      final id = await report('products', 'name', filters: '1=1) OR (1=1');
+      expect(await names(id), isEmpty);
+    });
+  });
+}
diff --git a/test/unit/report_filter_condition_test.dart b/test/unit/report_filter_condition_test.dart
new file mode 100644
index 00000000..aeaea42d
--- /dev/null
+++ b/test/unit/report_filter_condition_test.dart
@@ -0,0 +1,142 @@
+// ═══════════════════════════════════════════════════════════════════════════
+// ما تُرمّزه واجهةُ الفلتر لا بد أن يفهمه المحرِّك — والفحصُ بالتنفيذ لا بالشكل.
+// ═══════════════════════════════════════════════════════════════════════════
+//
+// [ReportFilterCondition] هو ما تحمله صفوفُ حوار الإنشاء، و[encodeReportFilters]
+// هو الجسرُ الوحيد بينها وبين العمود `filters`. فلو رمّزت الواجهةُ القيمةَ
+// نصّاً حيث ينتظر المحرِّك رقماً — أو رمّزت التاريخَ بصيغةٍ لا تُقرأ — رُفض
+// التقريرُ **كلُّه** عند التشغيل: صفرُ صفوفٍ بلا رسالةِ خطأ.
+//
+// ولذلك لا يفحص هذا الاختبارُ **شكلَ** الـJSON، بل يمرّره في `executeReport`
+// ويقيس الصفوفَ الراجعة. فحصُ الشكل يُثبّت التنفيذَ الحاليّ ولا يثبت أنه
+// مفهوم.
+// ═══════════════════════════════════════════════════════════════════════════
+
+import 'package:drift/drift.dart' hide isNotNull, isNull;
+import 'package:flutter_test/flutter_test.dart';
+import 'package:ural_erp/data/database/database.dart';
+import 'package:ural_erp/domain/models/report_filter_condition.dart';
+
+void main() {
+  late AppDatabase db;
+  var seq = 0;
+
+  Future<int> product(String name, double price, {bool isActive = true}) =>
+      db.into(db.products).insert(ProductsCompanion.insert(
+            code: 'P${++seq}',
+            name: name,
+            salePrice: Value(price),
+            isActive: Value(isActive),
+          ));
+
+  /// يمرّ بنفس مسار الواجهة: شرطٌ يُبنى من حقل، ثم يُرمَّز، ثم يُنفَّذ.
+  Future<List<String>> run(
+      String entity, String columns, List<ReportFilterCondition> conds) async {
+    final id = await db.into(db.customReports).insert(
+          CustomReportsCompanion.insert(
+            name: 'ت',
+            sourceEntity: entity,
+            columns: columns,
+            filters: Value(encodeReportFilters(conds)),
+          ),
+        );
+    final rows = await db.executeReport(id);
+    return rows.map((r) => r[columns.split(',').first.trim()].toString())
+        .toList();
+  }
+
+  ReportFilterCondition cond(String entity, String key, String op, String v) {
+    final f = db.getAvailableFields(entity).firstWhere((e) => e['key'] == key);
+    return ReportFilterCondition.forField(f, db.getFilterOperators).copyWith(op: op, value: v);
+  }
+
+  setUp(() async {
+    seq = 0;
+    db = AppDatabase.forTesting();
+    await product('قلم', 10);
+    await product('دفتر', 100);
+    await product('حاسوب', 5000);
+  });
+
+  tearDown(() => db.close());
+
+  test('الشرطُ الجديد يبدأ بأوّل عاملٍ معروضٍ لنوع الحقل', () {
+    final f = db
+        .getAvailableFields('products')
+        .firstWhere((e) => e['key'] == 'price');
+    final c = ReportFilterCondition.forField(f, db.getFilterOperators);
+    expect(c.field, 'price');
+    expect(c.type, 'number');
+    expect(db.getFilterOperators('number').map((o) => o['op']),
+        contains(c.op),
+        reason: 'عاملٌ ابتدائيّ خارج المعروض = منسدلةٌ فارغةُ الاختيار');
+  });
+
+  test('قيمةٌ رقميةٌ مكتوبةٌ نصّاً في الحقل تُقارَن رقماً', () async {
+    // ‏`TextFormField` يعطي `String` دائماً. فلو رُمّزت كما هي لصارت مقارنةَ
+    // نصٍّ برقمٍ في SQLite — ولا تطابق شيئاً.
+    final rows = await run(
+        'products', 'name', [cond('products', 'price', '>', '50')]);
+    expect(rows, containsAll(<String>['دفتر', 'حاسوب']));
+    expect(rows, isNot(contains('قلم')));
+  });
+
+  test('المنطقيُّ يُرمَّز قيمةً منطقيةً لا نصَّ "false"', () async {
+    await product('موقوف', 9, isActive: false);
+    final rows = await run(
+        'products', 'name', [cond('products', 'is_active', '=', 'false')]);
+    expect(rows, ['موقوف']);
+  });
+
+  test('التاريخُ يُرمَّز بصيغةٍ يقرأها المحرِّك', () async {
+    final wh = await db
+        .into(db.warehouses)
+        .insert(WarehousesCompanion.insert(name: 'مخزن'));
+    for (final (n, d) in [
+      ('INV-1', DateTime(2026, 8, 10, 14, 30)),
+      ('INV-2', DateTime(2026, 8, 12, 8, 0)),
+    ]) {
+      await db.into(db.salesInvoices).insert(SalesInvoicesCompanion.insert(
+            invoiceNumber: n,
+            warehouseId: wh,
+            userId: 1,
+            invoiceDate: d,
+          ));
+    }
+
+    final rows = await run('sales_invoices', 'invoice_number',
+        [cond('sales_invoices', 'date', '=', '2026-08-10')]);
+    expect(rows, ['INV-1']);
+  });
+
+  test('شرطان يُجمعان بـAND', () async {
+    final rows = await run('products', 'name', [
+      cond('products', 'price', '>', '5'),
+      cond('products', 'price', '<', '1000'),
+    ]);
+    expect(rows, containsAll(<String>['قلم', 'دفتر']));
+    expect(rows, isNot(contains('حاسوب')));
+  });
+
+  test('بلا شروطٍ ⇒ `null` لا نصٌّ فارغٌ ولا "[]"', () {
+    expect(encodeReportFilters(const []), isNull,
+        reason: 'العمودُ nullable — وقيمةٌ غيرُ فارغةٍ بلا شرطٍ تُوهم '
+            'أن للتقرير فلتراً');
+  });
+
+  group('اكتمالُ الشرط', () {
+    test('شرطٌ بلا قيمة غيرُ مكتمل', () {
+      expect(cond('products', 'name', '=', '').isComplete, isFalse);
+    });
+
+    test('المنطقيُّ مكتملٌ دائماً — "لا" قيمةٌ صحيحة', () {
+      expect(cond('products', 'is_active', '=', 'false').isComplete, isTrue);
+    });
+
+    test('الرقميُّ بقيمةٍ غيرِ رقميةٍ غيرُ مكتمل', () {
+      expect(cond('products', 'price', '>', 'غالي').isComplete, isFalse,
+          reason: 'يرفضه المحرِّك، فمنعُه عند الحفظ أوضح من تقريرٍ '
+              'محفوظٍ لا يُنتج صفاً أبداً');
+    });
+  });
+}
diff --git a/test/widget/report_builder_filter_dialog_test.dart b/test/widget/report_builder_filter_dialog_test.dart
new file mode 100644
index 00000000..81cb116e
--- /dev/null
+++ b/test/widget/report_builder_filter_dialog_test.dart
@@ -0,0 +1,141 @@
+// ═══════════════════════════════════════════════════════════════════════════
+// حوارُ إنشاء التقرير كان يبني الأعمدةَ **ولا يمرّر فلتراً أبداً**.
+// ═══════════════════════════════════════════════════════════════════════════
+//
+// السكيما توثّق عموداً للفلاتر منذ البداية، والمحرِّك يقرؤه — لكن الحوار كان
+// يستدعي `createCustomReport` بالاسم والكيان والأعمدة وحدها. فلا سبيلَ في
+// التطبيق كلِّه إلى بناء تقريرٍ مُصفّى.
+//
+// وهذا الاختبار يقطع المسارَ كاملاً بمستودعٍ **حقيقيّ** على قاعدةٍ في الذاكرة:
+// حوار ⇒ ترميز ⇒ عمود `filters` ⇒ `executeReport` ⇒ الصفوف. فلا يثبت أن
+// الحوار «مرّر شيئاً» بل أن ما مرّره **يُصفّي فعلاً**.
+// ═══════════════════════════════════════════════════════════════════════════
+
+import 'package:drift/drift.dart' hide isNotNull, isNull;
+import 'package:flutter/material.dart';
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+import 'package:flutter_test/flutter_test.dart';
+// ‏`providers.dart` يُصدّر `database.dart` — واستيرادُه صراحةً ملاحظةُ تحليل.
+import 'package:ural_erp/data/providers/providers.dart';
+import 'package:ural_erp/data/repositories/reporting_repository_impl.dart';
+import 'package:ural_erp/presentation/screens/report_builder_screen.dart';
+
+void main() {
+  late AppDatabase db;
+
+  Future<void> product(String code, String name, double price) =>
+      db.into(db.products).insert(ProductsCompanion.insert(
+          code: code, name: name, salePrice: Value(price)));
+
+  setUp(() async {
+    db = AppDatabase.forTesting();
+    await product('P1', 'قلم', 10);
+    await product('P2', 'حاسوب', 5000);
+  });
+
+  tearDown(() => db.close());
+
+  Future<void> pump(WidgetTester tester) async {
+    await tester.pumpWidget(ProviderScope(
+      overrides: [
+        reportingRepositoryProvider
+            .overrideWithValue(ReportingRepositoryImpl(db)),
+      ],
+      child: const MaterialApp(home: ReportBuilderScreen()),
+    ));
+    await tester.pumpAndSettle();
+  }
+
+  Future<void> openDialogWithName(WidgetTester tester, String name) async {
+    await tester.tap(find.text('جديد'));
+    await tester.pumpAndSettle();
+    await tester.enterText(
+        find.widgetWithText(TextField, 'اسم التقرير'), name);
+    await tester.tap(find.widgetWithText(CheckboxListTile, 'اسم المنتج'));
+    await tester.pumpAndSettle();
+  }
+
+  testWidgets('بلا شروطٍ: التقريرُ يُحفظ بفلترٍ خالٍ ويُرجع كلَّ الصفوف',
+      (tester) async {
+    await pump(tester);
+    await openDialogWithName(tester, 'كل الأصناف');
+    await tester.tap(find.text('إنشاء'));
+    await tester.pumpAndSettle();
+
+    final saved = (await db.select(db.customReports).get()).single;
+    expect(saved.filters, isNull,
+        reason: 'حوارٌ بلا شروطٍ لا يكتب `[]` — فيبقى التقريرُ بلا فلتر');
+    expect(await db.executeReport(saved.id), hasLength(2));
+  });
+
+  testWidgets('شرطٌ واحد: ما يُحفَظ يُصفّي فعلاً لا يُخزَّن وحسب',
+      (tester) async {
+    await pump(tester);
+    await openDialogWithName(tester, 'الحواسيب');
+
+    await tester.tap(find.text('الفلاتر'));
+    await tester.pumpAndSettle();
+    await tester.tap(find.text('إضافة شرط'));
+    await tester.pumpAndSettle();
+
+    await tester.enterText(
+        find.widgetWithText(TextFormField, 'القيمة'), 'حاسوب');
+    await tester.tap(find.text('إنشاء'));
+    await tester.pumpAndSettle();
+
+    final saved = (await db.select(db.customReports).get()).single;
+    expect(saved.filters, startsWith('['),
+        reason: 'الصيغةُ المهيكلة لا نصُّ SQL خامّ');
+
+    final rows = await db.executeReport(saved.id);
+    expect(rows.map((r) => r['name']), ['حاسوب'],
+        reason: 'التقريرُ المحفوظُ من الحوار يُصفّي — لا يرجع الصنفين');
+  });
+
+  testWidgets('شرطٌ بلا قيمة يُمنع عند الحفظ لا يُحفَظ فيُرفَض عند التشغيل',
+      (tester) async {
+    await pump(tester);
+    await openDialogWithName(tester, 'ناقص');
+
+    await tester.tap(find.text('الفلاتر'));
+    await tester.pumpAndSettle();
+    await tester.tap(find.text('إضافة شرط'));
+    await tester.pumpAndSettle();
+
+    // بلا كتابةِ قيمة
+    await tester.tap(find.text('إنشاء'));
+    await tester.pumpAndSettle();
+
+    expect(await db.select(db.customReports).get(), isEmpty,
+        reason: 'المحرِّك يرفض التقريرَ كلَّه لشرطٍ فاسد، فيُحفَظ تقريرٌ '
+            'لا يُنتج صفاً أبداً ولا يقول لماذا');
+    expect(find.text('إنشاء'), findsOneWidget, reason: 'الحوارُ يبقى مفتوحاً');
+
