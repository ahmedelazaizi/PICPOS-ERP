@@ -0,0 +1,103 @@
+// ═══════════════════════════════════════════════════════════════════════════
+// الفلترُ المهيكل على PostgreSQL — ‏`IS NOT` ليست لغةً مشتركة.
+// ═══════════════════════════════════════════════════════════════════════════
+//
+// المحرِّك يبني `!=` بـ`IS NOT` كي لا تُسقِط مقارنةُ NULL الصفوفَ الخالية.
+// و`x IS NOT y` عاملٌ صحيح في SQLite — أما في PostgreSQL فـ`IS NOT` لا يقبل
+// إلا `NULL`/`TRUE`/`FALSE`/`UNKNOWN`، ونظيرُه هناك `IS DISTINCT FROM`.
+//
+// فالفرقُ **خطأٌ نحويّ عند التشغيل** لا اختلافُ نتيجة: تقريرٌ بشرط «لا يساوي»
+// ينفجر على أيّ تنصيبٍ يعمل على PostgreSQL بينما يمرّ أخضرَ في كلّ اختبارات
+// SQLite. ولا تلتقطه سويّةُ الوحدات مهما كثرت.
+//
+// وهذا الملفّ يشغّل الصيغةَ المهيكلة كاملةً على قاعدةٍ حيّة: العواملُ الرقمية
+// والنصّية و«يحتوي» بمحارف البدل و«لا يساوي» على عمودٍ يقبل NULL.
+// ═══════════════════════════════════════════════════════════════════════════
+
+@Tags(['pg'])
+library;
+
+import 'dart:convert';
+
+import 'package:drift/drift.dart' hide isNotNull, isNull;
+import 'package:flutter_test/flutter_test.dart';
+import 'package:ural_erp/data/database/database.dart';
+
+import '_support/pg_fixture.dart';
+
+void main() {
+  late PgTestFixture fx;
+
+  setUpAll(() async {
+    fx = await bootPgTestSchema();
+    final db = fx.db;
+    await db.into(db.products).insert(ProductsCompanion.insert(
+        code: 'PG1', name: 'قلم', salePrice: const Value(10)));
+    await db.into(db.products).insert(ProductsCompanion.insert(
+        code: 'PG2',
+        name: 'حاسوب',
+        barcode: const Value('BC-1'),
+        salePrice: const Value(5000)));
+    await db.into(db.products).insert(ProductsCompanion.insert(
+        code: 'PG3', name: 'خصم %50', salePrice: const Value(7)));
+    await db.into(db.products).insert(ProductsCompanion.insert(
+        code: 'PG4', name: 'دفتر 50 ورقة', salePrice: const Value(8)));
+  });
+
+  tearDownAll(() async => fx.tearDown());
+
+  Future<List<String>> names(List<Map<String, Object?>> filters) async {
+    final db = fx.db;
+    final id = await db.into(db.customReports).insert(
+          CustomReportsCompanion.insert(
+            name: 'ت',
+            sourceEntity: 'products',
+            columns: 'name',
+            filters: Value(jsonEncode(filters)),
+          ),
+        );
+    final rows = await db.executeReport(id);
+    return rows.map((r) => r['name'] as String).toList()..sort();
+  }
+
+  group('الفلترُ المهيكل على PostgreSQL', () {
+    test('مقارنةٌ رقمية', () async {
+      expect(await names([
+        {'field': 'price', 'op': '>', 'value': 1000}
+      ]), ['حاسوب']);
+    });
+
+    test('«لا يساوي» يشمل الصفوفَ الخالية ولا يكسر الاستعلام', () async {
+      // ‏🔴 هنا كان ينفجر: `products.barcode IS NOT $1` خطأٌ نحويّ في
+      // PostgreSQL. والثلاثةُ بلا باركود «ليست BC-1» فعلاً.
+      expect(await names([
+        {'field': 'barcode', 'op': '!=', 'value': 'BC-1'}
+      ]), ['خصم %50', 'دفتر 50 ورقة', 'قلم']);
+    });
+
+    test('«يحتوي» يهرب محارفَ البدل', () async {
+      expect(await names([
+        {'field': 'name', 'op': 'contains', 'value': '%50'}
+      ]), ['خصم %50'],
+          reason: 'بلا هروبٍ يلتقط «دفتر 50 ورقة» أيضاً');
+    });
+
+    test('«يحتوي» لا يفرّق بين حالتَي الحرف — كما في SQLite', () async {
+      // ‏`LIKE` في SQLite لا يفرّق بين `abc` و`ABC`، وفي PostgreSQL يفرّق.
+      // فبلا `ILIKE` يعطي **نفسُ التقرير** نتيجتَين بحسب المحرِّك تحته.
+      final db = fx.db;
+      await db.into(db.products).insert(ProductsCompanion.insert(
+          code: 'PG5', name: 'Laptop PRO', salePrice: const Value(99)));
+
+      expect(await names([
+        {'field': 'name', 'op': 'contains', 'value': 'pro'}
+      ]), ['Laptop PRO']);
+    });
+
+    test('حقلٌ خارج القائمة المغلقة يُرفَض هنا أيضاً', () async {
+      expect(await names([
+        {'field': 'balance', 'op': '>', 'value': 0}
+      ]), isEmpty);
+    });
+  });
+}
diff --git a/test/unit/report_builder_filter_operators_test.dart b/test/unit/report_builder_filter_operators_test.dart
new file mode 100644
index 00000000..284ce93e
--- /dev/null
+++ b/test/unit/report_builder_filter_operators_test.dart
@@ -0,0 +1,122 @@
+// ═══════════════════════════════════════════════════════════════════════════
+// كلُّ عاملٍ تعرضه واجهةُ الفلتر لا بد أن يقبله المحرِّك — القائمةُ واحدة.
+// ═══════════════════════════════════════════════════════════════════════════
+//
+// واجهةُ الفلتر تبني منسدلةَ العامل من [getFilterOperators]، والمحرِّك يرفض
+// أيَّ عاملٍ خارج قائمته. فلو كانت القائمتان اثنتين لأمكن أن تعرض الواجهةُ
+// عاملاً يُنتج تقريراً **مرفوضاً بالكامل** — والمستخدم يرى صفراً من الصفوف
+// بلا سببٍ ظاهر، لا رسالةَ خطأ ولا حقلاً معطَّلاً.
+//
+// وهذه نفسُ فئةِ العطل التي كُتب لها `report_builder_field_registry_test`:
+// قائمةٌ تعرضها الواجهةُ وتخالف ما ينفّذه المحرِّك. وذاك فحص **الحقول**،
+// وهذا يفحص **العوامل** — وحاصلُ ضربِهما هو ما يستطيع المستخدمُ بناءه فعلاً.
+//
+// ⚠️ ويفشل تلقائياً لأيّ عاملٍ أو حقلٍ يُضاف مستقبلاً لأحد الطرفين وحده.
+// ═══════════════════════════════════════════════════════════════════════════
+
+import 'dart:convert';
+
+import 'package:drift/drift.dart' hide isNotNull, isNull;
+import 'package:flutter_test/flutter_test.dart';
+import 'package:ural_erp/data/database/database.dart';
+
+void main() {
+  late AppDatabase db;
+
+  const entities = [
+    'products',
+    'parties',
+    'sales_invoices',
+    'purchase_invoices',
+    'journal_entries',
+  ];
+
+  /// قيمةٌ تليق بالنوع — الغرضُ فحصُ القبول لا فحصُ النتيجة.
+  Object sampleFor(String type) => switch (type) {
+        'number' => 1,
+        'date' => '2026-08-10',
+        'boolean' => true,
+        _ => 'س',
+      };
+
+  setUp(() async => db = AppDatabase.forTesting());
+  tearDown(() => db.close());
+
+  test('كلُّ نوعِ حقلٍ معروضٍ له عواملُ معروضة', () {
+    final types = <String>{};
+    for (final e in entities) {
+      for (final f in db.getAvailableFields(e)) {
+        types.add(f['type']!);
+      }
+    }
+    expect(types, isNotEmpty);
+    for (final t in types) {
+      expect(db.getFilterOperators(t), isNotEmpty,
+          reason: 'نوعٌ «$t» بلا عوامل ⇒ حقلٌ لا يمكن الفلترةُ به وهو معروض');
+    }
+  });
+
+  group('كلُّ (حقل × عامل) تعرضه الواجهةُ يقبله المحرِّك', () {
+    for (final entity in entities) {
+      test(entity, () async {
+        final fields = db.getAvailableFields(entity);
+        final rejected = <String>[];
+
+        for (final f in fields) {
+          final key = f['key']!;
+          final type = f['type']!;
+          for (final op in db.getFilterOperators(type)) {
+            final id = await db.into(db.customReports).insert(
+                  CustomReportsCompanion.insert(
+                    name: 'ت-$key-${op['op']}',
+                    sourceEntity: entity,
+                    columns: key,
+                    filters: Value(jsonEncode([
+                      {
+                        'field': key,
+                        'op': op['op'],
+                        'value': sampleFor(type),
+                      }
+                    ])),
+                  ),
+                );
+            try {
+              await db.executeReport(id);
+            } catch (e) {
+              rejected.add('$key ${op['op']} → '
+                  '${e.toString().split('\n').first}');
+              continue;
+            }
+            // ‏«صفرُ صفوفٍ» ليس دليلاً — الجداولُ فارغة. الدليلُ أن الاستعلامَ
+            // **نُفِّذ**: سجلُّ التشغيل لا يُكتَب على المسار المرفوض.
+            final ran = await (db.select(db.savedReportRuns)
+                  ..where((r) => r.reportId.equals(id)))
+                .get();
+            if (ran.isEmpty) rejected.add('$key ${op['op']} → رُفض التقرير');
+          }
+        }
+
+        expect(rejected, isEmpty,
+            reason: 'عواملُ تعرضها الواجهةُ ويرفضها المحرِّك:\n'
+                '${rejected.join('\n')}');
+      });
+    }
+  });
+
+  test('عاملٌ خارج القائمة المعروضة يبقى مرفوضاً', () async {
+    // الحارسُ أعلاه يثبت أن المعروضَ مقبول؛ وهذا يثبت أن القائمة **تحصر**
+    // فعلاً، وإلا لمرّ كلُّ شيء ومرّ الحارسُ معه بلا معنى.
+    final id = await db.into(db.customReports).insert(
+          CustomReportsCompanion.insert(
+            name: 'ت',
+            sourceEntity: 'products',
+            columns: 'name',
+            filters: Value(jsonEncode([
+              {'field': 'name', 'op': 'REGEXP', 'value': 'س'}
+            ])),
+          ),
+        );
+    await db.executeReport(id);
+    expect(await db.select(db.savedReportRuns).get(), isEmpty);
+  });
+}
