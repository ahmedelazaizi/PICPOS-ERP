        "lines": [{"net": 3.705, "tax": 0.593, "total": 4.298}]}
    },
    {
      "name": "inclusive, 3 decimals",
      "pricesIncludeTax": true, "decimals": 3,
      "lines": [{"quantity": 2, "unitPrice": 0.75, "discount": 0, "taxRate": 16}],
