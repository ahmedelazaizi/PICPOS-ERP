        "lines": [{"net": 7.76, "tax": 1.24, "total": 9.0}]}
    },
    {
      "name": "exclusive, 3 decimals (JOD)",
      "pricesIncludeTax": false, "decimals": 3,
      "lines": [{"quantity": 3, "unitPrice": 1.235, "discount": 0, "taxRate": 16}],
