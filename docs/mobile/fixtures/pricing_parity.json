     "lists": [
       {"globalId": "L1", "isDefault": true, "isActive": true, "startDate": null, "endDate": null, "order": 1,
        "items": [{"price": 2.0, "minQuantity": 10}]},
       {"globalId": "L2", "isDefault": false, "isActive": true, "startDate": null, "endDate": null, "order": 2,
        "items": [{"price": 2.45, "minQuantity": 1}]}],
     "expect": {"price": 2.45, "source": "price_list", "listGlobalId": "L2"}}
