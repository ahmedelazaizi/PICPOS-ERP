      "expect": {"subtotal": 5.8, "discount": 0, "net": 5.0, "tax": 0.8, "total": 5.8,
        "lines": [{"net": 5.0, "tax": 0.8, "total": 5.8}]}
    },
    {
      "name": "inclusive with rounding + exempt line",
      "pricesIncludeTax": true, "decimals": 2,
      "lines": [
        {"quantity": 3, "unitPrice": 1.99, "discount": 0, "taxRate": 16},
        {"quantity": 1, "unitPrice": 1, "discount": 0, "taxRate": 0}
      ],
      "expect": {"subtotal": 6.97, "discount": 0, "net": 6.15, "tax": 0.82, "total": 6.97,
