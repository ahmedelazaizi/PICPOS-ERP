                "items": [{"price": 2.4, "minQuantity": 1}]}],
     "expect": {"price": 2.5, "source": "sale_price"}},
    {"name": "future list ignored", "salePrice": 2.5, "wholesalePrice": null, "priceLevel": null,
     "quantity": 1, "today": "2026-05-01",
     "lists": [{"globalId": "L1", "isDefault": true, "isActive": true, "startDate": "2026-05-02", "endDate": null, "order": 1,
                "items": [{"price": 2.4, "minQuantity": 1}]}],
     "expect": {"price": 2.5, "source": "sale_price"}},
    {"name": "inactive list ignored", "salePrice": 2.5, "wholesalePrice": null, "priceLevel": null,
     "quantity": 1, "today": "2026-05-01",
     "lists": [{"globalId": "L1", "isDefault": true, "isActive": false, "startDate": null, "endDate": null, "order": 1,
                "items": [{"price": 2.4, "minQuantity": 1}]}],
     "expect": {"price": 2.5, "source": "sale_price"}},
    {"name": "start/end dates are inclusive", "salePrice": 2.5, "wholesalePrice": null, "priceLevel": null,
     "quantity": 1, "today": "2026-05-01",
     "lists": [{"globalId": "L1", "isDefault": false, "isActive": true, "startDate": "2026-05-01", "endDate": "2026-05-01", "order": 1,
                "items": [{"price": 2.4, "minQuantity": 1}]}],
     "expect": {"price": 2.4, "source": "price_list", "listGlobalId": "L1"}},
    {"name": "default list wins over a lower-order list", "salePrice": 2.5, "wholesalePrice": null, "priceLevel": null,
     "quantity": 1, "today": "2026-05-01",
     "lists": [
       {"globalId": "L2", "isDefault": false, "isActive": true, "startDate": null, "endDate": null, "order": 1,
        "items": [{"price": 2.0, "minQuantity": 1}]},
       {"globalId": "L1", "isDefault": true, "isActive": true, "startDate": null, "endDate": null, "order": 2,
        "items": [{"price": 2.4, "minQuantity": 1}]}],
     "expect": {"price": 2.4, "source": "price_list", "listGlobalId": "L1"}},
    {"name": "list without a fitting tier falls through to the next list", "salePrice": 2.5, "wholesalePrice": null, "priceLevel": null,
