/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDI_APP_ICON            ICON                    "resources\\app_icon.ico"


/////////////////////////////////////////////////////////////////////////////
//
// Version
//

#if defined(FLUTTER_VERSION_MAJOR) && defined(FLUTTER_VERSION_MINOR) && defined(FLUTTER_VERSION_PATCH) && defined(FLUTTER_VERSION_BUILD)
#define VERSION_AS_NUMBER FLUTTER_VERSION_MAJOR,FLUTTER_VERSION_MINOR,FLUTTER_VERSION_PATCH,FLUTTER_VERSION_BUILD
#else
#define VERSION_AS_NUMBER 1,0,0,0
#endif

#if defined(FLUTTER_VERSION)
#define VERSION_AS_STRING FLUTTER_VERSION
#else
#define VERSION_AS_STRING "1.0.0"
#endif

// ── هوية المنتج ───────────────────────────────────────────────────────────
// بتيجي من CMake (windows/CMakeLists.txt) اللي بيقراها من متغيرات البيئة
// اللي سكربت بناء العلامة بيظبطها. القيم دي هي اللي المستخدم بيشوفها في
// «خصائص الملف» على الـ exe، فلو فضلت ثابتة كان PicPos هيوزّع ملف مكتوب
// عليه اسم منتج آخر. الافتراضي PicPos (قرار المالك 2026-10-23).
#if !defined(BRAND_BINARY_NAME)
#define BRAND_BINARY_NAME "PicPos"
#endif
#if !defined(BRAND_PRODUCT_NAME)
#define BRAND_PRODUCT_NAME "PicPos"
#endif
#if !defined(BRAND_COMPANY_NAME)
#define BRAND_COMPANY_NAME "PicPos"
#endif
#define BRAND_EXE_NAME BRAND_BINARY_NAME ".exe"
#define BRAND_COPYRIGHT "Copyright (C) 2026 " BRAND_COMPANY_NAME ". All rights reserved."

VS_VERSION_INFO VERSIONINFO
 FILEVERSION VERSION_AS_NUMBER
 PRODUCTVERSION VERSION_AS_NUMBER
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904e4"
        BEGIN
            VALUE "CompanyName", BRAND_COMPANY_NAME "\0"
            VALUE "FileDescription", BRAND_PRODUCT_NAME "\0"
            VALUE "FileVersion", VERSION_AS_STRING "\0"
            VALUE "InternalName", BRAND_BINARY_NAME "\0"
            VALUE "LegalCopyright", BRAND_COPYRIGHT "\0"
            VALUE "OriginalFilename", BRAND_EXE_NAME "\0"
            VALUE "ProductName", BRAND_PRODUCT_NAME "\0"
            VALUE "ProductVersion", VERSION_AS_STRING "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252
    END
END

#endif    // English (United States) resources
