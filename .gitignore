/dist/

# Security: license/keygen tooling must NEVER be tracked.
# Anyone with the repo could otherwise mint valid activation keys.
# Keep these on disk locally; the signing tool belongs in a separate private repo.
tools/*keygen*
tools/keygen_extracted/
tools/UralCash_License_Tool.*
tools/license.txt
tools/test_license.dart
tools/keygen.bat

# Inno Setup compiled output + downloaded prereqs
installer/output/

# Bundled PostgreSQL installer (354MB) — ship via download+checksum, never in git
tools/postgresql-*-windows-x64.exe

# ── استثناء: سكربتات بناء العلامات ──────────────────────────────────────
# الملفات دي مش سكربتات مؤقتة زي باقي الـ .bat — كل واحد منها هو **تعريف
# هوية منتج**: اسم الملف التنفيذي، اسم الشركة، حقوق النشر، الأيقونة، ومجلد
# الإخراج. لو مش متحكَّم في إصدارها، نسخة كاملة من منتج تبقى موجودة على
# جهاز واحد بس، ومحدش يقدر يراجع تغيير في هوية منتج بيتباع لعميل.
!build_release.bat
!build_picpos.bat
